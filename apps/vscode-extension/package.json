{
  "name": "general-simulator-gui",
  "displayName": "General Simulator GUI for VS Code",
  "description": "Schematic capture, component authoring and circuit/system simulation inside VS Code, powered by the general-simulator engine.",
  "version": "0.3.3",
  "private": false,
  "publisher": "gensim",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Data Science", "Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "generalSimulator",
          "title": "General Simulator",
          "icon": "media/gsim.svg"
        }
      ]
    },
    "views": {
      "generalSimulator": [
        {
          "id": "generalSimulator.library",
          "name": "Block Library",
          "type": "webview",
          "contextualTitle": "General Simulator"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "generalSimulator.schematic",
        "displayName": "General Simulator Schematic",
        "selector": [
          {
            "filenamePattern": "*.gsim_sch"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "generalSimulator.simResult",
        "displayName": "General Simulator Simulation Result",
        "selector": [
          {
            "filenamePattern": "*.gsim_sim_result"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "generalSimulator.showWaveforms",
        "title": "Show Waveforms",
        "category": "General Simulator",
        "icon": "$(graph-line)"
      },
      {
        "command": "generalSimulator.restartKernel",
        "title": "Restart Simulation Kernel",
        "category": "General Simulator",
        "icon": "$(debug-restart)"
      },
      {
        "command": "generalSimulator.showKernelLog",
        "title": "Show Kernel Log",
        "category": "General Simulator"
      },
      {
        "command": "generalSimulator.newSchematic",
        "title": "New Schematic",
        "category": "General Simulator"
      },
      {
        "command": "generalSimulator.openSchematic",
        "title": "Open Schematic…",
        "category": "General Simulator"
      },
      {
        "command": "generalSimulator.forwardChord",
        "title": "Forward a keyboard shortcut to the schematic",
        "enablement": "false"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "generalSimulator.showWaveforms",
          "when": "activeCustomEditorId == generalSimulator.schematic",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "generalSimulator.showWaveforms"
        },
        {
          "command": "generalSimulator.restartKernel"
        },
        {
          "command": "generalSimulator.showKernelLog"
        },
        {
          "command": "generalSimulator.newSchematic"
        }
      ]
    },
    "configuration": {
      "title": "General Simulator",
      "properties": {
        "generalSimulator.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the general-simulator checkout (the directory containing pyproject.toml). Leave empty to auto-discover from the open workspace folders.",
          "markdownDescription": "Folder holding the General Simulator Python checkout (the one with `pyproject.toml`) that the simulation kernel is started from. Empty uses the open workspace folders."
        },
        "generalSimulator.pythonRunner": {
          "type": "string",
          "default": "uv",
          "description": "Command used to run the kernel sidecar. With the default 'uv', the sidecar is launched as `uv run --project <root> python -m kernel_sidecar`.",
          "markdownDescription": "Command used to start the Python simulation kernel — `uv` by default. Set to `python` or an absolute interpreter path if you manage the environment yourself."
        },
        "generalSimulator.autoStartKernel": {
          "type": "boolean",
          "default": true,
          "description": "Start the kernel sidecar automatically when the extension activates.",
          "markdownDescription": "Start the simulation kernel automatically when the extension activates."
        },
        "generalSimulator.generalSimulatorPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `general-simulator` binary — the engine that actually runs a simulation.\n\nLeave empty to search, in order: this setting, `GENSIM_GENERAL_SIMULATOR_PATH`, then `PATH`, then a sibling `general-simulator` checkout beside the workspace. Build it with `cargo build --release -p general-simulator-cli` and point here at `target/release/general-simulator`.",
          "scope": "machine-overridable"
        },
        "generalSimulator.ngspicePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `ngspice` binary. Only needed for schematics run with the ngspice solver; the default engine does not use it. Empty searches `GENSIM_NGSPICE_PATH` then `PATH`.",
          "scope": "machine-overridable"
        },
        "generalSimulator.xycePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `Xyce` binary. Only needed for schematics run with the Xyce solver. Empty searches `GENSIM_XYCE_PATH` then `PATH`.",
          "scope": "machine-overridable"
        },
        "generalSimulator.octaveCliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `octave-cli` binary, for `octfunc` / `octblock` code blocks.\n\nThe engine looks this up on `PATH` only — it has no flag for it — so setting this puts its directory at the front of the `PATH` the simulation process inherits.",
          "scope": "machine-overridable"
        },
        "generalSimulator.pythonPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra directories to put on `PYTHONPATH` for `pyblock` / `pyfunc` code blocks, so a block can import your own modules.\n\nRelative entries resolve against the workspace folder. This does not change which interpreter runs — the engine embeds the one it was built against.",
          "scope": "machine-overridable"
        },
        "generalSimulator.environment": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Extra environment variables for the simulation kernel and everything it starts.\n\nAn escape hatch for anything without its own setting. Applied after the settings above, so an entry here wins.",
          "scope": "machine-overridable"
        },
        "generalSimulator.overrideVsCodeKeybindings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "While a schematic is the active editor, let the schematic's keyboard shortcuts override VS Code's. **On by default.**\n\nThe schematic binds 28 chords that VS Code also claims at the workbench level — `Ctrl+R` rotates the selection here and opens VS Code's recent-files list there — and without this VS Code wins every one of them, because a webview only sees a keystroke the workbench did not take first.\n\nTurn this off to give those chords back to VS Code. The schematic then loses them; the rest of its shortcuts keep working. See `docs/keyboard-conflicts.md` for the full list.\n\nThis only ever applies while a schematic tab is focused. A source file, the explorer and the terminal are untouched either way."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.gsim_sch": "json",
        "*.gsim_sym": "json",
        "*.gsim_sim_result": "json"
      }
    },
    "keybindings": [
      {
        "key": "ctrl+-",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+-"
        }
      },
      {
        "key": "ctrl++",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl++"
        }
      },
      {
        "key": "ctrl+0",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+0"
        }
      },
      {
        "key": "ctrl+alt+left",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Alt+Left"
        }
      },
      {
        "key": "ctrl+alt+right",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Alt+Right"
        }
      },
      {
        "key": "ctrl+b",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+B"
        }
      },
      {
        "key": "ctrl+e",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+E"
        }
      },
      {
        "key": "ctrl+k",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+K"
        }
      },
      {
        "key": "ctrl+n",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+N"
        }
      },
      {
        "key": "ctrl+o",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+O"
        }
      },
      {
        "key": "ctrl+p",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+P"
        }
      },
      {
        "key": "ctrl+r",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+R"
        }
      },
      {
        "key": "ctrl+s",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+S"
        }
      },
      {
        "key": "ctrl+shift+.",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+."
        }
      },
      {
        "key": "ctrl+shift+e",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+E"
        }
      },
      {
        "key": "ctrl+shift+i",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+I"
        }
      },
      {
        "key": "ctrl+shift+s",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+S"
        }
      },
      {
        "key": "ctrl+shift+t",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+T"
        }
      },
      {
        "key": "ctrl+shift+tab",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+Tab"
        }
      },
      {
        "key": "ctrl+shift+x",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+X"
        }
      },
      {
        "key": "ctrl+shift+y",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+Shift+Y"
        }
      },
      {
        "key": "ctrl+t",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+T"
        }
      },
      {
        "key": "ctrl+w",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "Ctrl+W"
        }
      },
      {
        "key": "f10",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "F10"
        }
      },
      {
        "key": "f11",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "F11"
        }
      },
      {
        "key": "f5",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
        "args": {
          "chord": "F5"
        }
      },
      {
        "key": "f6",
        "command": "generalSimulator.forwardChord",
        "when": "activeCustomEditorId == 'generalSimulator.schematic' && config.generalSimulator.overrideVsCodeKeybindings",
