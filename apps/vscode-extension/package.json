        }
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "tsc -p ./ && node ./out/integration/runTests.js",
    "package": "vsce package --no-dependencies --out ../../general-simulator-gui.vsix"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@vscode/vsce": "^3.2.0"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/GLODI-Engineering/general-simulator-gui-for-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/GLODI-Engineering/general-simulator-gui-for-vscode/issues"
  },
  "homepage": "https://github.com/GLODI-Engineering/general-simulator-gui-for-vscode#readme",
  "keywords": [
    "spice",
    "simulation",
    "schematic",
    "power-electronics",
    "circuit",
    "ngspice",
    "control-systems"
  ],
  "dependencies": {
    "@gensim/webview-protocol": "workspace:*"
  }
}
