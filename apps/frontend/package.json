{
  "name": "@gensim/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:validators": "node scripts/gen-validators.mjs",
    "gen:validators:check": "node scripts/gen-validators.mjs --check",
    "predev": "pnpm gen:validators",
    "prebuild": "pnpm gen:validators:check",
    "pretest": "pnpm gen:validators:check",
    "pretypecheck": "pnpm gen:validators:check",
    "build": "tsc --noEmit && vite build",
    "check:no-eval": "node scripts/check-no-eval.mjs",
    "postbuild": "pnpm check:no-eval",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "uplot": "^1.6.31",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "js-yaml": "^4.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^2.1.4"
  }
}
