{
  "name": "@gensim/webview-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p ./ && tsc -p ./tsconfig.esm.json",
    "typecheck": "tsc -p ./ --noEmit",
    "prepare": "tsc -p ./ && tsc -p ./tsconfig.esm.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "module": "dist/esm/index.js",
  "files": ["dist", "src"]
}
