{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://general-simulator.local/schemas/spice-cad-library-manifest.schema.json",
  "title": "Unified SPICE CAD Library Manifest",
  "description": "Schema for SPICE-CAD-LIBRARY-MANIFEST.{json,yaml} (cross-simulator federated manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "created_at",
    "project",
    "scope",
    "simulators",
    "sources",
    "per_simulator",
    "crosswalk"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "description": "ISO date string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "const": "cross-simulator-cad-library"
    },
    "simulators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "per_simulator": {
      "type": "object",
      "description": "Embedded simulator-specific manifests keyed by simulator name",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/simulatorManifest"
      }
    },
    "crosswalk": {
      "$ref": "#/$defs/crosswalk"
    }
  },
  "$defs": {
    "simulatorManifest": {
      "type": "object",
      "description": "Simulator-specific manifest is intentionally extensible",
      "required": ["manifest_version", "project"],
      "properties": {
        "manifest_version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": ["string", "null"]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "simulator": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/primaryElement"
          }
        }
      },
      "additionalProperties": true
    },
    "primaryElement": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "designator": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "ports": {
          "$ref": "#/$defs/portsField"
        },
        "port_spec": {
          "$ref": "#/$defs/portsField"
        },
        "model_required": {
          "type": "boolean"
        },
        "section": {
          "type": "string"
        },
        "netlist_template": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "portsField": {
      "description": "Port metadata can be a list, free-form descriptor, or model_defined marker",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object"
        }
      ]
    },
    "crosswalk": {
      "type": "object",
      "required": ["designator_map", "notes"],
      "properties": {
        "designator_map": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/designatorEntry"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "designatorEntry": {
      "type": "object",
      "description": "Per-simulator summaries keyed by simulator name",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/designatorSimulatorSummary"
      }
    },
    "designatorSimulatorSummary": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": ["string", "null"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "class": {
          "type": ["string", "null"]
        },
        "ports": {
          "$ref": "#/$defs/portsField"
        },
        "model_required": {
          "type": ["boolean", "null"]
        }
      },
      "additionalProperties": true
    }
  }
}
